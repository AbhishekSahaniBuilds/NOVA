
# ==========================================
# NOVA - Root Git Ignore
# ==========================================

# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ------------------------------------------
# Operating system files
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# IDE and editor files
# ------------------------------------------

# VS Code - allow shared project configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml

# Vim / temporary editor files
*.swp
*.swo
*~

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/

# ------------------------------------------
# Temporary files
# ------------------------------------------
*.tmp
*.temp
*.bak
*.old
*.orig

# ------------------------------------------
# Crash dumps
# ------------------------------------------
*.stackdump
*.core
core
core.*
